---
import { footerColumns, social, legalLinks, org, site, ecosystem } from '@/config/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const isExternal = (href: string) => href.startsWith('http');
const ext = (href: string) =>
  isExternal(href) ? { target: '_blank', rel: 'noopener' } : {};
---

<footer class="bg-navy" style="padding: 64px 6vw 36px;">
  <div
    class="grid gap-12 border-b border-white/[0.07] pb-12 sm:grid-cols-2 lg:grid-cols-[1.8fr_1fr_1fr_1fr_1fr]"
  >
    <div class="max-w-[300px]">
      <Logo tone="light" />
      <p class="mt-4 text-[13px] leading-[1.65] text-white/40">
        {site.tagline}
      </p>
      <div class="mt-5 border-t border-white/[0.06] pt-4">
        <span
          class="block text-[10px] uppercase tracking-[0.1em] text-white/25"
        >
          Une initiative de
        </span>
        <a
          href={org.url}
          target="_blank"
          rel="noopener"
          class="text-[13px] font-semibold text-sky transition-colors hover:text-white"
        >
          {org.name}
        </a>
        <span class="mt-2 block text-[10px] uppercase tracking-[0.1em] text-white/25">
          Plateforme partenaire
        </span>
        <a
          href={ecosystem.hub}
          target="_blank"
          rel="noopener"
          class="text-[13px] font-semibold text-sky transition-colors hover:text-white"
        >
          Haiti Talent Hub
        </a>
      </div>
    </div>

    {
      footerColumns.map((col) => (
        <nav aria-label={col.title}>
          <h2
            class="mb-4 text-[10px] font-semibold uppercase tracking-[0.16em] text-white/30"
          >
            {col.title}
          </h2>
          <ul class="flex flex-col gap-2.5">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  {...ext(link.href)}
                  class:list={[
                    'text-[13px] transition-colors',
                    link.here
                      ? 'font-semibold text-sky'
                      : 'text-white/50 hover:text-white',
                  ]}
                >
                  {link.label}
                  {link.here && (
                    <span class="ml-1 text-white/35">— Vous êtes ici</span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div
    class="flex flex-wrap items-center justify-between gap-4 pt-7"
  >
    <p class="text-[11px] text-white/25">
      © {year} {site.name}. Tous droits réservés.
      {
        legalLinks.map((l, i) => (
          <>
            {i === 0 ? ' · ' : ' · '}
            <a
              href={l.href}
              class="text-white/40 transition-colors hover:text-white/70"
            >
              {l.label}
            </a>
          </>
        ))
      }
    </p>

    <ul class="flex gap-[18px]">
      {
        social.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              class="text-[11px] font-semibold uppercase tracking-[0.09em] text-white/30 transition-colors hover:text-orange"
            >
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
