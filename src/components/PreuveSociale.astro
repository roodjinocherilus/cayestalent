---
/**
 * Bloc #1 — Preuve sociale (chiffres pilote). Doc 01 §4.
 * Version condensée utilisée en page d'accueil (doc 03 §3.3).
 * Visuel : bande de chiffres orange pleine (signature captalentlab).
 */
import { ArrowRight } from '@lucide/astro';
import { pilot } from '@/config/site';

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  eyebrow = 'Une méthode déjà validée',
  title = 'Une méthode déjà validée',
  subtitle = `${pilot.name} — ${pilot.city} — Janvier 2026`,
  ctaLabel = "Voir l'édition pilote",
  ctaHref = pilot.url,
} = Astro.props;
---

<section class="on-dark bg-navy">
  <div class="section-pad-x py-16 text-center md:py-20">
    <div class="eyebrow justify-center fu">{eyebrow}</div>
    <h2 class="h-section fu">{title}</h2>
    <p class="mt-3 text-[14px] uppercase tracking-[0.14em] text-sky-light fu">
      {subtitle}
    </p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 bg-orange">
    {
      pilot.stats.map((s, i) => (
        <div
          class:list={[
            'border-white/[0.18] px-6 py-10 text-center sm:px-8 sm:py-12',
            i < pilot.stats.length - 1 && 'lg:border-r',
            i % 2 === 0 && 'max-md:border-r',
            i < pilot.stats.length - 2 && 'border-b lg:border-b-0',
          ]}
        >
          <div
            class="font-display font-extrabold leading-none text-white"
            style="font-family: var(--font-display); font-size: clamp(34px, 4vw, 58px); margin-bottom:8px;"
          >
            {s.value}
          </div>
          <div class="text-[11px] font-medium uppercase leading-[1.4] tracking-[0.1em] text-white/70">
            {s.label}
          </div>
        </div>
      ))
    }
  </div>

  {
    ctaLabel && (
      <div class="section-pad-x py-12 text-center">
        <a
          href={ctaHref}
          target="_blank"
          rel="noopener"
          class="btn btn-outline on-dark fu"
        >
          {ctaLabel}
          <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    )
  }
</section>
