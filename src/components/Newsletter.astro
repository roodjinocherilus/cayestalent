---
/**
 * Bloc #6 — Newsletter / Restez informé. Doc 01 §4 / doc 03 §3.9.
 * Branché Formspree si PUBLIC_FORMSPREE_ID est défini (.env), sinon
 * état « bientôt actif » non bloquant.
 */
import { formsConfigured, formspreeEndpoint } from '@/config/site';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Restez informé',
  text = 'Recevez les annonces des Cayes — date confirmée, ouverture des candidatures, programme complet.',
} = Astro.props;
---

<section class="on-dark bg-navy">
  <div class="section-pad-x py-16 md:py-20">
    <div class="mx-auto max-w-[680px] text-center">
      <div class="eyebrow justify-center fu">{title}</div>
      <p class="mx-auto max-w-[520px] text-[16px] leading-[1.7] text-white/55 fu">
        {text}
      </p>

      <form
        class="js-nl mt-8 flex flex-col gap-3 sm:flex-row fu"
        action={formspreeEndpoint || undefined}
        method="POST"
      >
        <label class="sr-only" for="nl-email">Adresse e-mail</label>
        <input
          id="nl-email"
          type="email"
          name="email"
          required
          placeholder="votre@email.com"
          class="field flex-1 !border-white/15 !bg-white/[0.06] !text-white placeholder:!text-white/35"
        />
        <button type="submit" class="btn btn-primary shrink-0">
          S'inscrire
        </button>
      </form>

      {
        !formsConfigured && (
          <p class="mt-3 text-[12px] italic text-white/40">
            Inscription bientôt active (configuration e-mail en attente).
          </p>
        )
      }
      <p class="js-nl-ok mt-3 hidden text-[13px] font-medium text-sky-light">
        Merci ! Votre inscription est bien prise en compte.
      </p>
    </div>
  </div>
</section>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('.js-nl')) {
    form.addEventListener('submit', async (e) => {
      if (!form.action) {
        // Non configuré : on évite un envoi vers nulle part.
        e.preventDefault();
        return;
      }
      e.preventDefault();
      const ok = form.parentElement?.querySelector('.js-nl-ok');
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (res.ok) {
          form.reset();
          ok?.classList.remove('hidden');
        }
      } catch {
        /* silencieux : on n'effraie pas l'utilisateur */
      }
    });
  }
</script>
