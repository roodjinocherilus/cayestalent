---
// Page Programme — Doc 03 §8. Programme indicatif à compléter avec ZLC.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import TimelineEvent from '@/components/TimelineEvent.astro';
import Card from '@/components/Card.astro';
import Newsletter from '@/components/Newsletter.astro';

const jour1 = [
  { tag: '8h00', title: 'Accueil & check-in' },
  { tag: '9h00', title: "Conférence d'ouverture", text: '[Intervenant à confirmer]' },
  { tag: '10h30', title: 'Panel 1 — [Thème à définir]', text: '[Intervenants à confirmer]' },
  { tag: '12h00', title: 'Pause déjeuner' },
  { tag: '13h30', title: "Atelier 1 — Simulation d'entretien", text: '[Animateur à confirmer]' },
  { tag: '15h00', title: 'Lancement des entretiens directs' },
  { tag: '17h00', title: 'Clôture jour 1' },
];
const jour2 = [
  { tag: '8h00', title: 'Accueil' },
  { tag: '9h00', title: 'Atelier 2 — [À définir]' },
  { tag: '10h30', title: 'Panel 2 — [À définir]' },
  { tag: '12h00', title: 'Pause déjeuner' },
  { tag: '13h30', title: 'Entretiens directs (suite)' },
  { tag: '16h30', title: 'Cérémonie de clôture' },
  { tag: '17h00', title: "Fin de l'événement" },
];
---

<BaseLayout
  title="Programme"
  description="Le programme des deux jours du Cayes Talent Lab : conférences, ateliers, entretiens — un format intensif et structuré."
>
  <PageHero
    eyebrow="Programme"
    title={'Le programme des <span class="text-sky">deux jours</span>'}
    subtitle="Conférences, ateliers, entretiens — un format intensif et structuré."
    ghost="J1·J2"
  />

  <section class="section bg-white">
    <div class="mx-auto grid max-w-[1100px] gap-12 lg:grid-cols-2">
      <div>
        <div class="eyebrow fu">Jour 1</div>
        <h2 class="h-section fu">Timeline détaillée</h2>
        <div class="mt-9">
          <TimelineEvent steps={jour1} tone="light" numbered={false} />
        </div>
      </div>
      <div>
        <div class="eyebrow fu">Jour 2</div>
        <h2 class="h-section fu">Timeline détaillée</h2>
        <div class="mt-9">
          <TimelineEvent steps={jour2} tone="light" numbered={false} />
        </div>
      </div>
    </div>
  </section>

  {/* INTERVENANTS */}
  <section class="section bg-section">
    <div class="mx-auto max-w-[1100px]">
      <div class="eyebrow fu">Intervenants</div>
      <h2 class="h-section fu">Ils prennent la parole</h2>
      <div class="mt-9 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4 fu">
        {
          Array.from({ length: 4 }).map(() => (
            <Card padding="p-6">
              <div
                class="mx-auto h-20 w-20 rounded-full border border-dashed border-navy/20 bg-white"
                aria-hidden="true"
              />
              <p class="mt-4 text-center text-[14px] font-semibold text-navy">
                [Nom]
              </p>
              <p class="text-center text-[12px] text-muted">[Fonction]</p>
              <p class="mt-1 text-center text-[12px] text-muted">[Sujet]</p>
            </Card>
          ))
        }
      </div>
      <p class="mt-4 text-[12px] italic text-muted fu">
        À compléter au fur et à mesure des confirmations.
      </p>
    </div>
  </section>

  {/* ATELIERS DÉTAILLÉS */}
  <section class="section bg-white">
    <div class="mx-auto max-w-[1000px]">
      <div class="eyebrow fu">Ateliers détaillés</div>
      <h2 class="h-section fu">Le détail de chaque atelier</h2>
      <div class="mt-9 grid gap-5 md:grid-cols-2">
        {
          [0, 1].map((i) => (
            <Card class={`fu ${i ? 'fu-d1' : ''}`}>
              <h3
                class="font-display text-[19px] font-bold text-navy"
                style="font-family: var(--font-display);"
              >
                Atelier {i + 1}
              </h3>
              <ul class="mt-4 flex flex-col gap-2 text-[14px] text-ink">
                <li>• Objectif : [à définir]</li>
                <li>• Animateur : [à confirmer]</li>
                <li>• Pour qui : [à définir]</li>
                <li>• Durée : [à définir]</li>
                <li>• Compétences travaillées : [à définir]</li>
              </ul>
            </Card>
          ))
        }
      </div>
      <p
        class="mt-6 rounded-[8px] border-l-4 border-orange bg-section px-5 py-4 text-[13px] italic text-ink fu"
      >
        Programme indicatif — l'ensemble est à compléter avec ZLC
        (intervenants, sujets de panel, ateliers précis).
      </p>
    </div>
  </section>

  <Newsletter />
</BaseLayout>
