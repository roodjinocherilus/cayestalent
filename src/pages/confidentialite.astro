---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
---

<BaseLayout title="Politique de confidentialité" noindex>
  <PageHero eyebrow="Légal" title="Politique de confidentialité" />
  <section class="section bg-white">
    <div class="mx-auto max-w-[760px] text-[15px] leading-[1.8] text-ink">
      <p class="fu">
        Cette politique décrira la collecte et le traitement des données
        (formulaires de contact et d'inscription).
      </p>
      <p class="mt-4 italic text-muted fu">
        [Politique de confidentialité définitive à fournir par ZLC.]
      </p>
    </div>
  </section>
</BaseLayout>
