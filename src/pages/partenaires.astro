---
// Page Partenaires — Doc 03 §7. Copy verbatim.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PartenariatNiveaux from '@/components/PartenariatNiveaux.astro';
import Card from '@/components/Card.astro';
import Newsletter from '@/components/Newsletter.astro';
import { ArrowRight } from '@lucide/astro';
import { ecosystem } from '@/config/site';

const arguments_ = [
  "Édition d'ouverture = effet halo médiatique fort",
  'Visibilité régionale (Sud d’Haïti)',
  'Ancrage dans un programme national reconnu',
  'Cause à fort impact social',
];
---

<BaseLayout
  title="Partenaires"
  description="Devenez partenaire de la 1ʳᵉ édition nationale du Haiti Talent Lab. Une opportunité de visibilité régionale et nationale."
>
  <PageHero
    eyebrow="Partenaires"
    title={'Devenez partenaire de la <span class="text-sky">1ʳᵉ édition nationale</span>.'}
    subtitle="Cayes Talent Lab marque le début d'un programme national de 6 villes. C'est une opportunité de visibilité régionale ET nationale."
    ghost="2026"
    ctas={[
      { label: 'Télécharger le dossier de partenariat', href: '/contact' },
      { label: 'Prendre rendez-vous', href: '/contact', variant: 'outline' },
    ]}
  />

  {/* POURQUOI S'ASSOCIER */}
  <section class="section bg-white">
    <div class="mx-auto max-w-[1100px]">
      <div class="eyebrow fu">Pourquoi s'associer à Cayes Talent Lab</div>
      <h2 class="h-section fu">Quatre raisons fortes</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          arguments_.map((a, i) => (
            <Card accent="orange" class={`fu ${i ? `fu-d${i}` : ''}`}>
              <span
                class="font-display text-[34px] font-extrabold text-navy/15"
                style="font-family: var(--font-display);"
              >
                0{i + 1}
              </span>
              <p class="mt-3 text-[15px] font-medium leading-[1.55] text-navy">
                {a}
              </p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {/* BLOC #3 — NIVEAUX DE PARTENARIAT */}
  <PartenariatNiveaux />

  {/* PARTENAIRES DÉJÀ ENGAGÉS */}
  <section class="section bg-section">
    <div class="mx-auto max-w-[1100px] text-center">
      <div class="eyebrow justify-center fu">Partenaires déjà engagés</div>
      <div
        class="mt-8 grid grid-cols-2 gap-3.5 sm:grid-cols-3 lg:grid-cols-6 fu"
      >
        {
          Array.from({ length: 6 }).map(() => (
            <div class="flex h-20 items-center justify-center rounded-[8px] border border-dashed border-navy/15 bg-white">
              <span class="text-[10px] font-semibold uppercase tracking-[0.12em] text-navy/20">
                Logo
              </span>
            </div>
          ))
        }
      </div>
      <p class="mt-4 text-[12px] italic text-muted fu">
        Logos confirmés — à compléter au fil des signatures.
      </p>
    </div>
  </section>

  {/* PROGRAMME NATIONAL EN ARRIÈRE-PLAN */}
  <section class="section on-dark bg-navy">
    <div class="mx-auto max-w-[760px] text-center">
      <div class="eyebrow justify-center fu">Le programme national en arrière-plan</div>
      <p class="mt-4 text-[18px] leading-[1.7] text-white/70 fu">
        Au-delà de Cayes, le programme se déploie sur 6 villes en 12 mois.
        Un partenariat national est aussi possible.
      </p>
      <div class="mt-8 fu">
        <a
          href={`${ecosystem.haitiTalentLab}/partenaires`}
          target="_blank"
          rel="noopener"
          class="btn btn-outline on-dark"
        >
          Découvrir les partenariats nationaux <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>
