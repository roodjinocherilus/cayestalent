---
// Page Entreprises — page critique mobilisation recruteurs. Doc 03 §6.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import TimelineEvent from '@/components/TimelineEvent.astro';
import Faq from '@/components/Faq.astro';
import Card from '@/components/Card.astro';
import { ArrowRight } from '@lucide/astro';
import { ecosystem } from '@/config/site';

const pourquoi = [
  { t: 'Gain de temps', d: 'Présélection assurée par ZLC.' },
  { t: 'Réduction des coûts', d: 'Des coûts de recrutement maîtrisés.' },
  { t: 'Visibilité', d: 'Marque employeur dans le Sud.' },
  { t: 'Impact', d: "Contribuer à l'employabilité régionale." },
];
const timeline = [
  { tag: 'J-60', title: 'Inscription comme recruteur partenaire' },
  { tag: 'J-45', title: 'Définition des postes recherchés' },
  { tag: 'J-30', title: 'Réception des premiers profils' },
  { tag: 'J-15', title: 'Affinage de la sélection' },
  { tag: 'J / J+1', title: 'Entretiens directs sur place' },
  { tag: 'J+15', title: 'Suivi placement' },
  { tag: 'J+30', title: 'Bilan partagé' },
];
const secteurs = [
  'Agriculture & agro-industrie',
  'Tourisme & hôtellerie',
  'Services financiers',
  'Santé',
  'Éducation',
  'Construction',
  'Services / commerce',
  'ONG / coopération internationale',
];
const faq = [
  { q: 'Combien coûte la participation ?' },
  { q: 'Combien de candidats pourrons-nous rencontrer ?' },
  { q: 'Pouvons-nous publier nos offres en amont ?' },
  { q: 'Y a-t-il un engagement post-événement ?' },
];
---

<BaseLayout
  title="Entreprises"
  description="Recrutez les meilleurs talents du Sud d'Haïti. Deux jours pour rencontrer des dizaines de candidats présélectionnés et vérifiés."
>
  <PageHero
    eyebrow="Entreprises"
    title={'Recrutez les meilleurs talents du <span class="text-sky">Sud d\'Haïti</span>.'}
    subtitle="Deux jours pour rencontrer des dizaines de candidats présélectionnés et vérifiés."
    ghost="RECRUTER"
    ctas={[{ label: 'Devenir recruteur partenaire', href: '/contact' }]}
  />

  {/* POURQUOI PARTICIPER */}
  <section class="section bg-white">
    <div class="mx-auto max-w-[1100px]">
      <div class="eyebrow fu">Pourquoi participer</div>
      <h2 class="h-section fu">Quatre bénéfices concrets</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {
          pourquoi.map((p, i) => (
            <Card accent="sky" class={`fu ${i ? `fu-d${i}` : ''}`}>
              <h3
                class="font-display text-[19px] font-bold text-navy"
                style="font-family: var(--font-display);"
              >
                {p.t}
              </h3>
              <p class="mt-2 text-[14px] leading-[1.6] text-ink">{p.d}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {/* COMMENT ÇA SE PASSE */}
  <section class="section bg-section">
    <div class="mx-auto max-w-[760px]">
      <div class="eyebrow fu">Comment ça se passe</div>
      <h2 class="h-section fu">De l'inscription au bilan</h2>
      <div class="mt-10">
        <TimelineEvent steps={timeline} tone="light" numbered={false} />
      </div>
    </div>
  </section>

  {/* NIVEAUX DE PARTICIPATION */}
  <section class="section bg-white">
    <div class="mx-auto max-w-[1000px]">
      <div class="eyebrow fu">Niveaux de participation</div>
      <h2 class="h-section fu">Choisissez votre format</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <Card class="fu">
          <h3
            class="font-display text-[20px] font-bold text-navy"
            style="font-family: var(--font-display);"
          >
            Recruteur simple
          </h3>
          <p class="mt-3 text-[15px] leading-[1.6] text-ink">
            Participation seule.
          </p>
        </Card>
        <Card accent="orange" class="fu fu-d1">
          <h3
            class="font-display text-[20px] font-bold text-navy"
            style="font-family: var(--font-display);"
          >
            Recruteur sponsor
          </h3>
          <p class="mt-3 text-[15px] leading-[1.6] text-ink">
            Visibilité + recrutement.
          </p>
        </Card>
      </div>
      <p class="mt-6 text-[15px] leading-[1.7] text-ink fu">
        Pour les niveaux nationaux, rendez-vous sur
        <a
          href={`${ecosystem.haitiTalentLab}/partenaires`}
          target="_blank"
          rel="noopener"
          class="font-semibold text-sky underline-offset-2 hover:underline"
          >haititalentlab.com/partenaires</a
        >.
      </p>
    </div>
  </section>

  {/* QUI A PARTICIPÉ AU PILOTE */}
  <section class="section bg-section">
    <div class="mx-auto max-w-[1100px]">
      <div class="eyebrow fu">Qui a participé au pilote</div>
      <h2 class="h-section fu">20+ entreprises au Cap Talent Lab</h2>
      <div class="mt-9 grid grid-cols-2 gap-3.5 sm:grid-cols-4 lg:grid-cols-5 fu">
        {
          Array.from({ length: 10 }).map(() => (
            <div class="flex h-20 items-center justify-center rounded-[8px] border border-dashed border-navy/15 bg-white">
              <span class="text-[10px] font-semibold uppercase tracking-[0.12em] text-navy/20">
                Logo
              </span>
            </div>
          ))
        }
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {
          [0, 1].map((i) => (
            <Card class={`fu ${i ? 'fu-d1' : ''}`}>
              <p class="text-[14px] italic leading-[1.7] text-ink">
                « [Témoignage entreprise pilote à recueillir auprès de ZLC] »
              </p>
              <span class="mt-4 block text-[13px] font-semibold text-navy">
                [Entreprise] — [Fonction]
              </span>
            </Card>
          ))
        }
      </div>
      <p class="mt-4 text-[12px] italic text-muted fu">
        Logos des 20+ entreprises + 2 témoignages — à rassembler.
      </p>
    </div>
  </section>

  {/* SECTEURS REPRÉSENTÉS / RECHERCHÉS */}
  <section class="section bg-white">
    <div class="mx-auto max-w-[1000px]">
      <div class="eyebrow fu">Secteurs représentés / recherchés</div>
      <h2 class="h-section fu">Une demande large dans le Sud</h2>
      <ul class="mt-8 flex flex-wrap gap-3 fu">
        {
          secteurs.map((s) => (
            <li class="rounded-full border border-line bg-section px-5 py-2.5 text-[14px] font-medium text-navy">
              {s}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* FAQ */}
  <Faq eyebrow="FAQ Entreprises" title="Vos questions" items={faq} />

  {/* CTA FINAL */}
  <section class="section on-dark bg-navy">
    <div class="mx-auto max-w-[760px] text-center">
      <h2 class="h-section fu">Recrutez avec nous aux Cayes</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-3 fu">
        <a href="/contact" class="btn btn-primary">
          Devenir recruteur partenaire <ArrowRight class="h-4 w-4" />
        </a>
        <a href="/contact" class="btn btn-outline on-dark">
          Demander un rendez-vous
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
