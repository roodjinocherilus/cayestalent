---
// Page L'événement — infos pratiques. Doc 03 §4. Copy verbatim.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Faq from '@/components/Faq.astro';
import Card from '@/components/Card.astro';
import MapEmbed from '@/components/MapEmbed.astro';
import Newsletter from '@/components/Newsletter.astro';
import { ArrowRight } from '@lucide/astro';
import { event, eventSchema } from '@/config/site';

const infos = [
  { icon: '📅', t: 'Dates', v: `[À confirmer] juillet 2026` },
  { icon: '📍', t: 'Lieu', v: '[À confirmer], Les Cayes' },
  { icon: '⏰', t: 'Horaires', v: '8h–17h les deux jours' },
  {
    icon: '🎟️',
    t: 'Accès',
    v: 'Sur inscription (gratuit pour candidats présélectionnés)',
  },
  { icon: '🚗', t: 'Comment venir', v: '[Adresse + plan + indications]' },
  {
    icon: '🏨',
    t: 'Hébergement',
    v: '[Suggestions partenaires hôteliers si pertinent]',
  },
];
const faq = [
  { q: 'Faut-il payer pour participer ?' },
  { q: 'Quand sont publiés les résultats de présélection ?' },
  { q: 'Que faut-il apporter ?' },
  { q: 'Y a-t-il un dress code ?' },
  { q: 'Comment se passe l’entretien ?' },
];
---

<BaseLayout
  title="L'événement"
  description="Cayes Talent Lab — tout ce qu'il faut savoir pour participer : dates, lieu, accès, programme."
  schema={eventSchema}
>
  <PageHero
    eyebrow="L'événement"
    title={'Cayes Talent Lab — <span class="text-sky">l\'événement</span>'}
    subtitle="Tout ce qu'il faut savoir pour participer."
    ghost="2026"
  />

  {/* INFOS PRATIQUES */}
  <section class="section bg-white">
    <div class="mx-auto max-w-[1100px]">
      <div class="eyebrow fu">Infos pratiques</div>
      <h2 class="h-section fu">La carte d'identité de l'événement</h2>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          infos.map((info, i) => (
            <Card class={`fu ${i % 3 ? `fu-d${i % 3}` : ''}`}>
              <span class="text-[26px]" aria-hidden="true">
                {info.icon}
              </span>
              <h3 class="mt-3 text-[12px] font-bold uppercase tracking-[0.14em] text-orange">
                {info.t}
              </h3>
              <p class="mt-1.5 text-[15px] leading-[1.5] text-navy">
                {info.v}
              </p>
            </Card>
          ))
        }
      </div>
      <MapEmbed class="mt-6 fu" />
    </div>
  </section>

  {/* QUI PEUT PARTICIPER */}
  <section class="section bg-section">
    <div class="mx-auto max-w-[1000px]">
      <div class="eyebrow fu">Qui peut participer ?</div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          [
            { t: 'Candidats', d: 'Profil candidat éligible.' },
            { t: 'Entreprises', d: 'Profil entreprise éligible.' },
            {
              t: 'Public général',
              d: 'Sur invitation (conférences).',
            },
          ].map((p, i) => (
            <Card accent="sky" class={`fu ${i ? `fu-d${i}` : ''}`}>
              <h3
                class="font-display text-[19px] font-bold text-navy"
                style="font-family: var(--font-display);"
              >
                {p.t}
              </h3>
              <p class="mt-2 text-[14px] text-ink">{p.d}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  {/* CE QUE VOUS Y FEREZ */}
  <section class="section bg-white">
    <div class="mx-auto max-w-[760px]">
      <div class="eyebrow fu">Ce que vous y ferez</div>
      <h2 class="h-section fu">Deux jours intensifs et structurés</h2>
      <p class="mt-5 text-[16px] leading-[1.7] text-ink fu">
        Conférences, ateliers de préparation et entretiens directs entre
        candidats présélectionnés et entreprises recruteuses.
      </p>
      <div class="mt-7 fu">
        <a href="/programme" class="btn btn-outline">
          Voir le programme complet <ArrowRight class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>

  <Faq eyebrow="FAQ Événement" title="Questions fréquentes" items={faq} />

  <Newsletter />
</BaseLayout>
